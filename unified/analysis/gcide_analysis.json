{
  "dictionary_id": "gcide",
  "dictionary_name": "GCIDE英英词典",
  "format_description": "类似Webster词典风格，带有词源和引用",
  "identified_patterns": [
    {
      "name": "title",
      "pattern": "\\\\([^\\\\]+)\\\\",
      "description": "词条标题使用反斜杠包围"
    },
    {
      "name": "source_year",
      "pattern": "\\[(\\d{4})\\s+\\w+\\]",
      "description": "来源和年份标记，如 [1913 Webster]"
    },
    {
      "name": "citation",
      "pattern": "--([A-Z][a-zA-Z]+)",
      "description": "引用来源，如 --Shak. (Shakespeare)"
    },
    {
      "name": "root_ref",
      "pattern": "\\{([^}]+)\\}",
      "description": "词根或相关词引用，使用花括号",
      "examples": [
        "Better",
        "Best",
        "Gather",
        "As good as",
        "As"
      ]
    }
  ],
